# GitHub Linguist configuration — controls the language bar on the repo page.

# Linguist treats any path containing `docs/` as documentation and excludes it
# from language statistics. schema.sql lives there, so opt it back in.
backend/docs/** linguist-documentation=false

# Make sure SQL is always counted, wherever it lives.
*.sql linguist-detectable=true

# Captured API responses are test data, not hand-written source. Excluding them
# keeps a 37KB fixture from swamping the stats (and collapses them in diffs).
backend/tests/fixtures/*.json linguist-generated=true
